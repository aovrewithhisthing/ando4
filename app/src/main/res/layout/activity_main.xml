<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EFE8"
    android:padding="12dp"
    tools:context=".MainActivity">

    <!-- HEADER: Bar Atas -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#2C3E35"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/text_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Anto          [Omong Dewe Lur]"
            android:textColor="#D8E2D8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_burger"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#3B5347"
            android:fontFamily="monospace"
            android:text="☰ Menu"
            android:textColor="#D8E2D8"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- RecyclerView for Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/divider_bottom"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EFEFEF"
        android:padding="8dp"
        tools:listitem="@layout/item_message_sent" />

    <!-- GARIS PEMBATAS -->
    <View
        android:id="@+id/divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_above="@id/layout_bottom"
        android:layout_marginBottom="8dp"
        android:background="#2C3E35" />

    <!-- BOTTOM INPUT & BUTTONS -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:hint="Ketik pesan..."
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColor="#1C2826"
            android:textColorHint="#7A8B82"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#2C3E35"
            android:fontFamily="monospace"
            android:minHeight="48dp"
            android:text="SEND"
            android:textColor="#D8E2D8"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4A6B5B"
            android:fontFamily="monospace"
            android:minHeight="48dp"
            android:text="SWITCH"
            android:textColor="#D8E2D8"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
